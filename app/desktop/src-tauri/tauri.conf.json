{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RYZENStrata",
  "mainBinaryName": "ryzenstrata-desktop",
  "identifier": "ai.ryzenstrata.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-harness-bundle.mjs",
    "frontendDist": "../../host/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI for Ryzen AI Max+ 395 and 495.",
    "longDescription": "RYZENStrata runs the ISTA-DASLab Qwen3.8-Flash-Next Q2_0 model on a Ryzen AI Max+ 395 or 495.",
    "resources": {
      "../../host/dist": "host/dist",
      "../../host/server": "host/server",
      "../../host/package.json": "host/package.json",
      "resources/node": "node",
      "resources/control": "control",
      "resources/harness": "harness",
      "resources/engine-bundle": "engine-bundle"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "languages": [
          "English"
        ]
      }
    }
  }
}
